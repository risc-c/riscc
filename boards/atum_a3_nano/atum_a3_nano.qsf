set_location_assignment PIN_BM14 -to sd_dqm[3]

# IS42VM32160G Table 7: maximum input capacitance, in pF.
set_instance_assignment -name OUTPUT_PIN_LOAD 4 -to {sd_clk}
set_instance_assignment -name OUTPUT_PIN_LOAD 4 -to {sd_cke}
set_instance_assignment -name OUTPUT_PIN_LOAD 4 -to {sd_cs_n}
set_instance_assignment -name OUTPUT_PIN_LOAD 4 -to {sd_ras_n}
set_instance_assignment -name OUTPUT_PIN_LOAD 4 -to {sd_cas_n}
set_instance_assignment -name OUTPUT_PIN_LOAD 4 -to {sd_we_n}
set_instance_assignment -name OUTPUT_PIN_LOAD 4 -to {sd_addr[*]}
set_instance_assignment -name OUTPUT_PIN_LOAD 4 -to {sd_ba[*]}
set_instance_assignment -name OUTPUT_PIN_LOAD 4 -to {sd_dqm[*]}
set_instance_assignment -name OUTPUT_PIN_LOAD 5 -to {sd_dq[*]}
