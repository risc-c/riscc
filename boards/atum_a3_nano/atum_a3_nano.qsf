set_instance_assignment -name IO_STANDARD "1.8-V LVCMOS" -to sd_dq[20]
set_instance_assignment -name IO_STANDARD "1.8-V LVCMOS" -to sd_dq[21]
set_instance_assignment -name IO_STANDARD "1.8-V LVCMOS" -to sd_dq[22]
