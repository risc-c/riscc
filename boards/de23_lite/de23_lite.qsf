# DE23-Lite rev B. Pin names and assignments follow the Terasic resource kit.
# Paths are relative to build/de23_lite/quartus (or the corresponding test build).
set_global_assignment -name FAMILY "Agilex 3"
set_global_assignment -name DEVICE A3CZ135BB18AE7S
set_global_assignment -name TOP_LEVEL_ENTITY top
source ../../../boards/shared/agilex3.qsf
set_global_assignment -name VERILOG_FILE ../../../boards/de23_lite/rtl/top.v
